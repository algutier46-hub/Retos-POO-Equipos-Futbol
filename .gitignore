# .gitignore for Java / OOP football teams project
# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Maven
target/

# Gradle
.gradle/
build/

# IntelliJ IDEA
.idea/
*.iml
out/

# Eclipse
.project
.classpath
.settings/

# VS Code
.vscode/

# NetBeans
/nbproject/private/
build/
nbbuild/
dist/

# macOS
.DS_Store

# Windows
Thumbs.db

# Environment variables / secrets
.env

# Generated files
*.class
*.jar

# Temporary files
*.tmp
*.swp
*~

# Node modules (if any front-end)
node_modules/

# Python cache (in case there are scripts)
__pycache__/
*.py[cod]

# Others
*.iml
.idea/

# End of file
